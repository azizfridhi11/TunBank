# Required — PostgreSQL connection string
# On Railway: provided automatically when you add a PostgreSQL plugin
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required — Secret used to sign session cookies
# Generate a strong random string, e.g.: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-strong-random-secret

# Optional — Required only if you use the AI Chat / TunBot feature
# Get this from your OpenAI account or Replit AI Integrations
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional — Set automatically by Railway, do not override
# PORT=5000
